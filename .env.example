MONGODB_URL=mongodb://localhost:27017/noap
SECRET=your_512_bit_jwt_secret_at_least_64_chars_long_random_string
MAIL_HOSTNAME=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=your_email@example.com
MAIL_PASSWORD=your_mail_password
HOST_MAIL=noreply@noap.example.com
IPGEOLOCATION_KEY=your_ipgeolocation_api_key
PORT=3002
RUST_LOG=info
# Exact frontend origin(s) allowed to call the API, comma-separated.
# Production MUST set this to the deployed frontend, e.g.:
# ALLOWED_ORIGINS=https://noap.vercel.app
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:3000
# Session cookie transport. Production default (Secure + SameSite=None) is
# required for cross-site cookie auth over HTTPS. For plain-http local dev:
# COOKIE_SECURE=false (SameSite auto-downgrades to Lax).
COOKIE_SECURE=true
COOKIE_SAMESITE=None
